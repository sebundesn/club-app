# --- データベース ---
# 個別指定（DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME）でも起動できる
DATABASE_URL=postgres://postgres:password@localhost:5432/club_db?sslmode=disable

# --- サーバー ---
PORT=8080
# CORS の許可オリジン。フロントの起動URLと一致させること
FRONTEND_URL=http://localhost:3000

# --- セッション ---
# ランダムな長い文字列。例: openssl rand -base64 32
SESSION_SECRET_KEY=

# --- Cookie ---
# production 以外では Secure を付けない。
# http://localhost では Secure Cookie がブラウザに保存されず、ログインできなくなる。
APP_ENV=development
COOKIE_SECURE=false
# フロントとバックが別ドメインの本番環境では none にする（Secure=true が必須）
COOKIE_SAMESITE=lax

# --- LINEログイン ---
# LINE Developers でプロバイダーと「LINEログイン」チャネルを作成して取得する。
# チャネルの設定画面で、下の LINE_REDIRECT_URI をコールバックURLとして登録すること。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:8080/api/auth/line/callback
